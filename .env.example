# Server
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://reloadb.com
# 企业微信“微信客服”生成的公开 HTTPS 接入链接。
# 示例：https://work.weixin.qq.com/kf/xxxx 或 https://work.weixin.qq.com/kfid/xxxx
WECOM_CUSTOMER_SERVICE_URL=https://work.weixin.qq.com/kfid/kfcd7c68ab23401a2ba

# Supplier adapter. Replace with the values from the ReloadN API documentation.
SUPPLIER_API_BASE_URL=https://api.reloadn.com
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=
SUPPLIER_ORDER_PATH=/v1/orders
SUPPLIER_WEBHOOK_SECRET=
# ReloadN product prices use the merchant account currency but do not repeat
# that currency on every SKU. This merchant account is settled in IDR.
SUPPLIER_ACCOUNT_CURRENCY=IDR
# ReloadN documents its complete recharge catalogue as type=topup. The sync
# follows every returned cursor and keeps every SKU, including unclassified
# products. Use comma-separated types only if ReloadN provides more type names.
SUPPLIER_PRODUCT_TYPES=topup
CATALOG_MIN_RETENTION_RATIO=0.25
MAX_FX_AGE_HOURS=36
FX_MAX_FUTURE_SKEW_SECONDS=300
FX_IDR_CNY_MIN=1000
FX_IDR_CNY_MAX=5000
FX_MAX_CHANGE_RATIO=0.15
# `auto` uses ExchangeRate-API when a key is configured and otherwise falls
# back to the free daily open.er-api feed. The API key is server-side only.
FX_PROVIDER=auto
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_REFRESH_MINUTES=60
COINBASE_EXCHANGE_RATE_URL=https://api.coinbase.com/v2/exchange-rates
COINBASE_REFRESH_MINUTES=60
OPEN_ER_API_URL=https://open.er-api.com/v6/latest/CNY
OPEN_ER_API_REFRESH_MINUTES=480

# Provider-specific field names can be adjusted in src/provider.js after reviewing the docs.
SUPPLIER_TIMEOUT_MS=10000
ADMIN_USER=admin
# Run `node scripts/generate-admin-auth.mjs` to generate these values.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Plaintext fallback for migration only. Prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=
# Do not put WeChat private keys in this file in production.
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_NOTIFY_URL=https://api.reloadb.com/api/wechat/notify
